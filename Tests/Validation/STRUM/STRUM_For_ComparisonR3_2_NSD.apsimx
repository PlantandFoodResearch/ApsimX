                    "namespace Models",
                    "{",
                    "    [Serializable]",
                    "    public class Script : Model",
                    "    {",
                    "        [Link] private IWeather weather;",
                    "",
                    "        public double RadiationFactor { get; set; } = 1.0;",
                    "        public double WindFactor { get; set; } = 1.0;",
                    "",
                    "        [EventSubscribe(\"DoWeather\")]",
                    "        private void OnDoWeather(object sender, EventArgs e)",
                    "        {",
                    "            weather.Radn *= RadiationFactor;",
                    "            weather.Wind *= WindFactor;",
                    "        }",
                    "    }",
                    "}",
                    ""
