            {
              "$type": "Models.Core.Simulation, Models",
              "Name": "Site7",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Clock, Models",
                  "Start": "1994-06-21T00:00:00",
                  "End": "2020-12-01T00:00:00",
                  "Name": "Clock",
