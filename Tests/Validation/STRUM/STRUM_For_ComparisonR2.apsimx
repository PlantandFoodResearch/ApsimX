                        "[Row].STRUM.RootUptakesArbitrator.NitrogenUptake.Amount",
                        "[Row].STRUM.RootUptakesArbitrator.WaterSupply.AmountByZone",
                        "[Row].STRUM.RootUptakesArbitrator.WaterSupply.Mm",
