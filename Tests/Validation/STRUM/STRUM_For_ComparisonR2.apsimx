                        "[Row].STRUM.Arbitrator.Carbon.TotalPlantSupply",
                        "[Row].STRUM.Arbitrator.Carbon.TotalPlantDemandsAllocated",
                        "[Row].STRUM.Arbitrator.Fn",
                        "[Row].STRUM.Arbitrator.Nitrogen.TotalPlantDemand",
