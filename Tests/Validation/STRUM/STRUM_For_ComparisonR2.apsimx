              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "*\tThis is a Gold3 orchard\n*\tDidn't irrigate during covid - 2019/20 was really dry\n*\tLocated in Opotiki\n\n+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++\n\n*\tUsing Whakatane weather - see reason below -\n*\tMany missing data points in Opotiki Metwatch!!!! (see csv file)",
                  "Name": "ReadMe",
                  "ResourceName": null,
