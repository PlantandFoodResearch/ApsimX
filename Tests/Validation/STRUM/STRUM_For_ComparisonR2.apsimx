      "Name": "ObsPred",
      "ResourceName": null,
      "Children": [
        {
          "$type": "Models.Graph, Models",
          "Caption": null,
          "Axis": [
            {
              "$type": "APSIM.Shared.Graphing.Axis, APSIM.Shared",
              "Title": null,
              "Position": 3,
              "Inverted": false,
              "CrossesAtZero": false,
              "LabelOnOneLine": false,
              "Minimum": "NaN",
              "Maximum": "NaN",
              "Interval": 2.0
            },
            {
              "$type": "APSIM.Shared.Graphing.Axis, APSIM.Shared",
