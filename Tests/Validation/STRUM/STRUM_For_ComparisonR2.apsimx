                        "[Row].STRUM.Height.PrunedCanopyBaseHeight  + [Row].STRUM.Height.PrunedCanopyDepth ",
                        "[Row].STRUM.Height.PrunedCanopyBaseHeight  + [Row].STRUM.Height.PrunedCanopyDepth + [Row].STRUM.Height.SeasonalDepthGrowth ",
                        "[Row].STRUM.Leaf.Allocated.Carbon.Total",
                        "[Row].STRUM.Leaf.Allocated.Nitrogen.Total",
                        "[Row].STRUM.Leaf.Canopy.CoverGreen",
                        "[Row].STRUM.Leaf.Canopy.Deepness",
                        "[Row].STRUM.Leaf.Dead.Wt",
