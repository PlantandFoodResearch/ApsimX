            {
              "$type": "Models.Core.Simulation, Models",
              "Name": "Omahu_Goldx",
              "ResourceName": null,
              "Children": [
                {
                  "$type": "Models.Memo, Models",
                  "Text": "*\tLocated Hawke's Bay\n* \tSheltered and netted \n*\tIrrigated (SG to provide info)\n\n++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++\n\nMeasurements were\n*\tSap-flow\n*\tFruit growth\n*\tSoil moisture (150–160; 30/20 cm interval); TDR\n*\tLight interception. \n",
                  "Name": "ReadMe",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": false,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Clock, Models",
                  "Start": "2017-07-01T00:00:00",
                  "End": "2025-12-01T00:00:00",
                  "Name": "Clock",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": false,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Summary, Models",
                  "Verbosity": 100,
                  "Name": "SummaryFile",
                  "ResourceName": null,
                  "Children": [],
                  "Enabled": false,
                  "ReadOnly": false
                },
                {
                  "$type": "Models.Climate.Weather, Models",
                  "ConstantsFile": null,
                  "FileName": "Weather_SG/TrinityHill.met",
                  "ExcelWorkSheetName": "",
                  "Name": "Weather",
                  "ResourceName": null,
                  "Children": [],
