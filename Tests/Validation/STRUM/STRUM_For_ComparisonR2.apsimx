                    "        //[Description(\" Date to end the simulation year and reset: \")]",
                    "        //public string ResetDate { get; set; }",
                    "                  ",
                    "        [JsonIgnore] public double SimulationYear { get; set; }",
                    "        [JsonIgnore] public double DAS { get; set; }",
                    "        ",
                    "         [EventSubscribe(\"StartOfSimulation\")]",
                    "        private void DoStartOfSimulation(object sender, EventArgs e)",
                    "        {",
                    "                DAS = 0;",
                    "                SimulationYear = 1983;",
                    "        }",
                    "        ",
                    "        [EventSubscribe(\"StartOfDay\")]",
                    "        private void OnStartOfDay(object sender, EventArgs e)",
                    "        {",
                    "            DAS += 1;",
                    "            //if (DateUtilities.DatesAreEqual(ResetDate, Clock.Today.Date))",
                    "            if (DateUtilities.DatesAreEqual(\"Jul-1\", Clock.Today.Date))",
                    "            {",
                    "                SimulationYear += 1;",
                    "                DAS = 1;",
                    "                ",
                    "            }",
                    "        }",
                    "    ",
                    "    }",
                    "}",
                    "                "
