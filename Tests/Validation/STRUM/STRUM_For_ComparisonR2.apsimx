                        "[Row].STRUM.RootUptakesArbitrator.NitrogenSupply.AmountByZone",
                        "[Row].STRUM.RootUptakesArbitrator.NitrogenSupply.Gpm2",
                        "[Row].STRUM.RootUptakesArbitrator.NitrogenSupply.Amount",
                        "[Row].STRUM.Root.Wt",
                        "[Row].STRUM.TranspirationPerTree",
                        "[Row].STRUM.Wood.Allocated.Carbon.Total",
                        "[Row].STRUM.Wood.Allocated.Nitrogen.Total",
                        "[Row].STRUM.Wood.Carbon.Demands.Structural",
                        "[Row].STRUM.Wood.Carbon.Demands.Total",
                        "[Row].STRUM.Wood.Carbon.Supplies.ReTranslocation",
                        "[Row].STRUM.Wood.Live.Carbon.Structural * 1/0.4",
                        "[Row].STRUM.Wood.Live.Carbon.Storage * 1/0.4",
                        "[Row].STRUM.Wood.EnergyBalance.CoverTotal",
                        "[Row].STRUM.Wood.EnergyBalance.DeadAreaIndex",
                        "[Row].STRUM.Wood.EnergyBalance.LAIDead",
                        "[Row].STRUM.Wood.EnergyBalance.RadiationInterceptedByDead",
                        "[Row].STRUM.Wood.EnergyBalance.Transpiration",
                        "[Row].STRUM.Wood.N",
