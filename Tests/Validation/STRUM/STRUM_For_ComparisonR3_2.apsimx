                            "[Row].STRUM.Arbitrator.Nitrogen.TotalPlantSupply",
                            "[Row].STRUM.Arbitrator.Nitrogen.TotalPlantDemandsAllocated",
                            "[Row].STRUM.Fruit.TotalCarbonDemand.RelativeFruitMass.Delta.Integral",
                            "[Row].STRUM.Fruit.Allocated.Carbon.Total",
                            "[Row].STRUM.Fruit.Allocated.Nitrogen.Total",
                            "[Row].STRUM.Fruit.Carbon.Demands.Structural",
                            "[Row].STRUM.Fruit.Carbon.Demands.Total",
                            "[Row].STRUM.Fruit.DMC",
                            "[Row].STRUM.Fruit.FreshWtPerFruit",
                            "[Row].STRUM.Fruit.NextYearsFruitingBudSurvival",
                            "[Row].STRUM.Fruit.Number.BudsSurvivalFromLastYear",
                            "[Row].STRUM.Fruit.N",
                            "[Row].STRUM.Fruit.Nitrogen.Demands.Total",
                            "[Row].STRUM.Fruit.Number",
                            "[Row].STRUM.Fruit.Diameter",
                            "[Row].STRUM.Fruit.VolumePerFruit",
                            "[Row].STRUM.Fruit.Wt",
                            "[Row].STRUM.Fruit.PotentialDWPerFruit",
                            "[Row].STRUM.Fruit.TotalCarbonDemand.RelativeFruitMass",
                            "[Row].STRUM.Fruit.TotalCarbonDemand.CarbonConc",
                            "[Row].STRUM.Height",
                            "[Row].STRUM.Height.PrunedCanopyBaseHeight ",
                            "[Row].STRUM.Height.PrunedCanopyBaseHeight  + [Row].STRUM.Height.PrunedCanopyDepth ",
                            "[Row].STRUM.Height.PrunedCanopyBaseHeight  + [Row].STRUM.Height.PrunedCanopyDepth + [Row].STRUM.Height.SeasonalDepthGrowth ",
                            "[Row].STRUM.Leaf.Allocated.Carbon.Total",
                            "[Row].STRUM.Leaf.Allocated.Nitrogen.Total",
                            "[Row].STRUM.Leaf.Canopy.CoverGreen",
                            "[Row].STRUM.Leaf.Canopy.Deepness",
                            "[Row].STRUM.Leaf.Dead.Wt",
                            "[Row].STRUM.Leaf.Carbon.Demands.Structural",
