                    {
                      "$type": "Models.Manager, Models",
                      "CodeArray": [
                        "using Newtonsoft.Json;",
                        "using Models.PMF.Organs;",
                        "using Models.Soils.Nutrients;",
                        "using Models.Interfaces;",
                        "using System;",
                        "using Models.Core;",
                        "using System.Collections.Generic;",
                        "using System.Text;",
                        "using Models.Soils;",
                        "using Models.PMF;",
                        "using Models;",
                        "using System.Xml.Serialization;",
                        "using APSIM.Shared.Utilities;",
                        "using Models.Climate;",
                        "",
                        "",
                        "",
                        "namespace Models",
                        "{",
                        "    [Serializable] ",
                        "    //[System.Xml.Serialization.XmlInclude(typeof(Model))]",
                        "    public class Script : Model",
                        "    {",
                        "    ",
                        "     [Link] private Clock Clock;",
                        "        ",
                        "    [Separator(\"Helper script to summarise variables\")]",
                        "    [Description(\" Date to reset the day counter: \")]",
                        "    public string ResetDate { get; set; }",
                        "                  ",
                        "        [JsonIgnore] public double SimulationYear { get; set; }",
                        "        [JsonIgnore] public double DAS { get; set; }",
                        "        ",
                        "         [EventSubscribe(\"StartOfSimulation\")]",
                        "        private void DoStartOfSimulation(object sender, EventArgs e)",
                        "        {",
                        "                DAS = 0;",
                        "                SimulationYear = Clock.Today.Year;",
                        "        }",
                        "        ",
                        "        [EventSubscribe(\"StartOfDay\")]",
                        "        private void OnStartOfDay(object sender, EventArgs e)",
                        "        {",
                        "            DAS += 1;",
                        "            if (DateUtilities.DatesAreEqual(ResetDate, Clock.Today.Date))",
                        "            //if (DateUtilities.DatesAreEqual(\"Jul-1\", Clock.Today.Date))",
                        "            {",
                        "                SimulationYear += 1;",
                        "                DAS = 1;",
                        "                ",
                        "            }",
                        "        }",
                        "    ",
                        "    }",
                        "}",
                        "                "
                      ],
                      "Parameters": [
                        {
                          "Key": "ResetDate",
                          "Value": "01-Jul"
                        }
                      ],
                      "Name": "ResetDate",
                      "ResourceName": null,
                      "Children": [],
                      "Enabled": true,
                      "ReadOnly": false
                    }
                  ],
                  "Enabled": true,
                  "ReadOnly": false
