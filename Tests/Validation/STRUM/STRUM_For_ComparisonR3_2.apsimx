                            "[Row].STRUM.RootUptakesArbitrator.WaterDemand.Amount",
                            "[Row].STRUM.RootUptakesArbitrator.WaterDemand.mm",
                            "[Row].STRUM.RootUptakesArbitrator.NitrogenDemand.Amount",
                            "[Row].STRUM.Root.Network.WtByLayerZone1",
                            "[Row].STRUM.Root.Network.WtByLayerZone2",
                            "[Row].STRUM.Arbitrator.Carbon.TotalPlantDemand",
                            "[Row].STRUM.Arbitrator.Carbon.TotalPlantSupply",
                            "[Row].STRUM.Arbitrator.Carbon.TotalPlantDemandsAllocated",
