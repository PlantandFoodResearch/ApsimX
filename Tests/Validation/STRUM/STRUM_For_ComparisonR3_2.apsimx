                      "SurfaceKL": 0.1,
                      "WaterStress": true,
                      "Number": 60,
                      "PotentialFWPerFruit": 110.0,
                      "DMC": 0.17,
                      "FruitDensity": 1.02,
                      "DateMaxBloom": "7-Nov",
                      "DAFStartLinearGrowth": 90,
                      "DAFEndLinearGrowth": 180,
                      "DAFMaxSize": 200,
