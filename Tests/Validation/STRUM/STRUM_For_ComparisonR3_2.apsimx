                            "([Row].Soil.OutputLayers.SWmm[1] + [Row].Soil.OutputLayers.SWmm[2]+ [Row].Soil.OutputLayers.SWmm[3]) as SWmm0_120",
                            "([Row].Soil.OutputLayers.SWmm[1] + [Row].Soil.OutputLayers.SWmm[2]+ [Row].Soil.OutputLayers.SWmm[3] + [Row].Soil.OutputLayers.SWmm[4]) as SWmm0_160",
                            "[Row].Soil.OutputLayers.SW",
                            "[Row].Soil.OutputLayers.SAT",
                            "[Row].Soil.OutputLayers.DUL",
                            "[Row].Soil.OutputLayers.LL15",
                            "[Row].Soil.SoilWater.Evaporation",
                            "[Row].Soil.SoilWater.Eo",
                            "[Weather].PanEvap",
                            "[Weather].Radn",
                            "[Weather].Rain",
                            "[STRUM].Leaf.TotalCarbonDemand.TotalDMDemand.SizeDemand.SizeDemand.SizeDemand.TargetSize"
                          ],
